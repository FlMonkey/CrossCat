  "scoring_rules": {
    "preference_range": {
      "min": -1.0,
      "max": 1.0,
      "meaning": {
        "-1.0": "strongly_exclude",
        "-0.5": "prefer_to_avoid",
        "0.0": "neutral_or_unspecified",
        "0.5": "prefer",
        "1.0": "strongly_want"
      }
    },
    "hard_filter_examples": [
      "category",
      "type",
      "subtype",
      "price_min",
      "price_max",
      "size",
      "color",
      "gender_market",
      "availability"
    ],
    "type_gate": {
      "enabled": true,
      "logic": "If the query explicitly specifies a garment type, products outside that type receive a score of 0.",
      "hierarchical": true,
      "example": "Querying 'pants' allows jeans, trousers, chinos, cargo pants, sweatpants, and leggings, but excludes jackets and shirts."
    },
    "null_semantics": {
      "null": "attribute_not_applicable",
      "0": "attribute_applies_but_is_absent_or_minimal"
    },
    "recommended_pipeline": [
      "parse_user_query",
      "extract_hard_filters",
      "apply_type_gate",
      "load_applicable_attribute_schema",
      "extract_soft_preferences",
      "score_attribute_match",
      "score_embedding_similarity",
      "apply_business_rules",
      "rank_results"
    ]
  },
